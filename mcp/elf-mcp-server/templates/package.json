{
  "name": "@elf-express/<server-name>",
  "version": "1.0.0",
  "description": "<one sentence: which knowledge this MCP server exposes>",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "<server-name>": "dist/index.js" },
  "files": ["dist", "README.md"],
  "packageManager": "pnpm@<PNPM_VERSION>",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": { "node": ">=24.18" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.21.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
