# Copy to .env next to docker-compose.mcpjungle.yml (or fill the GitOps tool's env editor). .env is never committed.

# MCPJungle backend DB. Use the DB host's IP (not a container name); this stack does NOT include Postgres.
MCPJUNGLE_DATABASE_URL=postgres://mcpjungle:<DB_PASSWORD>@<DB_HOST_IP>:<DB_PORT>/mcpjungle?sslmode=disable

# Optional (defaults in compose):
# SERVER_MODE=development                 # development = NO client auth on the gateway (see SKILL.md security rules)
# MCPJUNGLE_HOST_PORT=18800
# MCPJUNGLE_DATA_DIR=/mnt/docker/app/data/mcpjungle   # host dir mounted read-only at /host for the filesystem server
# MCP_SERVER_INIT_REQ_TIMEOUT_SEC=30      # raised 10 -> 30 in bafd8e8 (npx first-run downloads)
# TZ=Asia/Taipei
# DOCS_MCP_AUTH_TOKEN=                    # empty in dev; when set, also add bearer_token to servers/*.json and pass it to registrar
