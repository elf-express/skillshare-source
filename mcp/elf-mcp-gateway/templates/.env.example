# 一鍵起 gateway + Postgres + docs-mcp + registrar 用。
#
# 零設定即可跑 —— DB 已內建,不必先準備一顆 Postgres、不必 docker network create:
#   docker compose up -d --build
#
# 本檔所有項目都是「選用」。需要改預設值時才複製成 .env 填寫。.env 不進 git。

# ── 內建 Postgres ──────────────────────────────────────────────
# 預設帳號 / 密碼 / DB 名皆為 mcpjungle,且不對外開 port(僅 mcpjungl 網路內可達)。
# 正式環境請改密碼,並「同步」改下面 MCPJUNGLE_DATABASE_URL 裡的密碼 —— 兩處要一致。
# POSTGRES_USER=mcpjungle
# POSTGRES_PASSWORD=mcpjungle
# POSTGRES_DB=mcpjungle

# ── 資料庫連線字串 ─────────────────────────────────────────────
# 不填 = 連內建那顆 postgres 容器(預設值如下)。
# MCPJUNGLE_DATABASE_URL=postgres://mcpjungle:mcpjungle@postgres:5432/mcpjungle?sslmode=disable
#
# 要改接「既有的外部 DB」才填這個:host 用你 DB 的 IP、port 用該 DB 實際監聽的 port。
# 填了就不會用內建那顆(容器仍會起,可用 docker compose stop postgres 關掉)。
# MCPJUNGLE_DATABASE_URL=postgres://mcpjungle:你的密碼@192.168.25.100:15432/mcpjungle?sslmode=disable

# ── 其他選用(有預設值,不填即用預設)────────────────────────────
# MCPJUNGLE_DATA_DIR=/mnt/docker/app/data/mcpjungle   # filesystem server 讀的 host 目錄
# SERVER_MODE=development
# MCPJUNGLE_HOST_PORT=18800
# DOCS_MCP_AUTH_TOKEN=
# TZ=Asia/Taipei
